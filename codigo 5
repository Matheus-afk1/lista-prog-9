#include <iostream>
using namespace std;

struct Aluno {
    string nome;
    int matricula;
    string curso;
};

int main() {
    Aluno alunos[5];

    for (int i = 0; i < 5; i++) {
        cout << "Nome: ";
        cin >> alunos[i].nome;

        cout << "Matricula: ";
        cin >> alunos[i].matricula;

        cout << "Curso: ";
        cin >> alunos[i].curso;
    }

    cout << "\nALUNOS\n";

    for (int i = 0; i < 5; i++) {
        cout << alunos[i].nome << endl;
        cout << alunos[i].matricula << endl;
        cout << alunos[i].curso << endl;
    }

    return 0;
}
